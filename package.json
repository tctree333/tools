		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.2"
	},
	"type": "module",
	"imports": {
		"#app.css": "./src/app.css"
